{
  "name": "@ipc-network/bridge-sdk",
  "version": "0.1.0",
  "description": "Developer SDK for the IPC cross-chain token bridge (Filecoin Calibration ↔ Ethereum Sepolia)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["ipc", "bridge", "filecoin", "ethereum", "cross-chain", "erc20"],
  "license": "MIT OR Apache-2.0"
}
